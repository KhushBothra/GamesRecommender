QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=game_embeddings
QDRANT_API_KEY=

USE_GROQ=true
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_MODEL=qwen3:4b
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
# Request all model layers on the GPU. Set to 0 only to force CPU execution.
OLLAMA_NUM_GPU=999
OLLAMA_TIMEOUT_SECONDS=180
